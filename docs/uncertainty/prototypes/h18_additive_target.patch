+/// PR H18: steady change of each node's throughflow when node i receives an
+/// extra inflow dq[i]. T_i = dq_i + sum over incoming edges of the upstream
+/// node's T times the edge's share of that node's outflow (|q| over all its
+/// outgoing edges, structures included). A node with no outgoing edge keeps
+/// what it receives; a pinned node (spilling at its rim) passes nothing on.
+/// Upstream-first Kahn order; Gauss-Seidel on flow cycles.
+inline void accumulateThroughflow(int n, const std::vector<FlowEdge>& edges,
+                                  const double* dq, std::vector<double>& T,
+                                  const std::vector<char>* pinned = nullptr,
+                                  int max_passes = 50) {
+    const auto un = static_cast<std::size_t>(std::max(n, 0));
+    T.assign(un, 0.0);
+    if (n <= 0) return;
+    std::vector<double> qout(un, 0.0);
+    for (const auto& e : edges)
+        if (e.up >= 0 && e.up < n) qout[static_cast<std::size_t>(e.up)] += std::fabs(e.q);
+    std::vector<std::vector<std::pair<int, double>>> in(un);   // (upstream node, share)
+    std::vector<int> pending(un, 0);
+    std::vector<std::vector<int>> next(un);
+    for (const auto& e : edges) {
+        if (e.up < 0 || e.up >= n || e.dn < 0 || e.dn >= n) continue;
+        const auto uu = static_cast<std::size_t>(e.up);
+        const double share = (qout[uu] > 0.0) ? std::fabs(e.q) / qout[uu] : 0.0;
+        in[static_cast<std::size_t>(e.dn)].emplace_back(e.up, share);
+        ++pending[static_cast<std::size_t>(e.dn)];
+        next[uu].push_back(e.dn);
+    }
+    auto passOn = [&](int u) {
+        return (pinned && static_cast<std::size_t>(u) < pinned->size() && (*pinned)[static_cast<std::size_t>(u)])
+               ? 0.0 : T[static_cast<std::size_t>(u)];
+    };
+    auto update = [&](int i) {
+        double t = dq[i];
+        for (const auto& [u, share] : in[static_cast<std::size_t>(i)]) t += share * passOn(u);
+        return t;
+    };
+    std::vector<int> queue;
+    queue.reserve(un);
+    for (int i = 0; i < n; ++i) if (pending[static_cast<std::size_t>(i)] == 0) queue.push_back(i);
+    std::vector<char> done(un, 0);
+    for (std::size_t h = 0; h < queue.size(); ++h) {
+        const int i = queue[h];
+        T[static_cast<std::size_t>(i)] = update(i);
+        done[static_cast<std::size_t>(i)] = 1;
+        for (int d : next[static_cast<std::size_t>(i)])
+            if (--pending[static_cast<std::size_t>(d)] == 0) queue.push_back(d);
+    }
+    if (queue.size() == un) return;
+    for (int pass = 0; pass < max_passes; ++pass) {
+        double change = 0.0, scale = 0.0;
+        for (int i = 0; i < n; ++i) {
+            if (done[static_cast<std::size_t>(i)]) continue;
+            const double v = update(i);
+            change = std::max(change, std::fabs(v - T[static_cast<std::size_t>(i)]));
+            scale = std::max(scale, std::fabs(v));
+            T[static_cast<std::size_t>(i)] = v;
+        }
+        if (change <= 1.0e-10 * (scale + 1.0e-12)) break;
+    }
+    for (double& v : T) if (!std::isfinite(v)) v = 0.0;
+}
